# Copy this file to .env and fill in values only when needed.
# Never commit a real .env file.

# Optional: OpenAI-compatible API key for AI extraction (Phase 6+).
# Leave unset to use rule-based extraction only.
# Having a key does NOT enable AI by itself — also set ai.enabled: true
# and ai.provider: openai_compatible in config/settings.yaml.
# SAKURASCOPE_AI_API_KEY=
# Optional overrides:
# SAKURASCOPE_AI_BASE_URL=https://api.openai.com/v1
# SAKURASCOPE_AI_MODEL=gpt-4o-mini

# Optional: override default paths (normally set in YAML config).
# SAKURASCOPE_CONFIG_PATH=config/settings.yaml
# SAKURASCOPE_DATA_DIR=data/runtime
# SAKURASCOPE_LOG_LEVEL=INFO
